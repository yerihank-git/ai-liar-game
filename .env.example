# ────────────────────────────────────────────────────────────
# LiarGame AI — 환경 변수 설정 예시
# 이 파일을 복사해서 .env.local 로 저장 후 실제 값을 채워주세요.
# .env.local 은 절대 Git에 커밋하지 마세요.
# ────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Supabase 프로젝트 URL (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase 익명 키 — 브라우저 클라이언트용 (공개 가능)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase 서비스 역할 키 — 서버사이드 전용 (절대 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (Anthropic Claude) ────────────────────────────────────
# Claude API 키 (https://console.anthropic.com/)
# 서버사이드(API Routes)에서만 사용되며 브라우저에 노출되지 않습니다.
ANTHROPIC_API_KEY=sk-ant-your-api-key

# ── GitHub Actions Secrets (배포 자동화용) ───────────────────
# 아래 값들은 .env.local 이 아닌 GitHub Repository Secrets에 등록하세요.
# Settings > Secrets and variables > Actions > New repository secret
#
# VERCEL_TOKEN      — Vercel 계정 토큰 (https://vercel.com/account/tokens)
# VERCEL_ORG_ID     — vercel.json 또는 .vercel/project.json 에서 확인
# VERCEL_PROJECT_ID — vercel.json 또는 .vercel/project.json 에서 확인
# NEXT_PUBLIC_SUPABASE_URL      (위와 동일)
# NEXT_PUBLIC_SUPABASE_ANON_KEY (위와 동일)
# SUPABASE_SERVICE_ROLE_KEY     (위와 동일)
# ANTHROPIC_API_KEY             (위와 동일)
